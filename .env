# ============================================================
# VETLINK — Configuration d'environnement
# Copier ce fichier en .env et NE PAS le committer dans git.
# ============================================================

# Environnement : "prod" ou "dev"
APP_ENV=prod
DEBUG=true
AUTO_MIGRATE=true

# Fuseau horaire
TZ=Africa/Casablanca

# Nom affiché de l'application
SITE_NAME=VETLINK

# URL de base (chemin depuis la racine web, terminer par /)
BASE_URL=noxo.top/vetlink/

# Nom de la session PHP (unique à l'appli)
SESSION_NAME=VETLINKSESSID

# Cookie sécurisé HTTPS uniquement (true en prod, false en dev HTTP)
COOKIE_SECURE=true

# ---- Base de données ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetlink_db
DB_USER=vetlink_usr
DB_PASS=SnY8bkrrfTSwxxWP
DB_CHARSET=utf8mb4
