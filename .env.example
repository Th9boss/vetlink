# ============================================================
# VETLINK — Template de configuration (.env.example)
# Copier en .env et remplir les valeurs réelles.
# Ce fichier PEUT être commité (pas de credentials).
# ============================================================

APP_ENV=prod
DEBUG=false
AUTO_MIGRATE=true
TZ=Africa/Casablanca
SITE_NAME=VETLINK
BASE_URL=/vetlink/
SESSION_NAME=VETLINKSESSID
COOKIE_SECURE=true

DB_HOST=localhost
DB_NAME=vetlink_db
DB_USER=vetlink_usr
DB_PASS=votre_mot_de_passe_ici
DB_CHARSET=utf8mb4
